{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SqlServer": "Server=localhost;Database=SapSync;Integrated Security=True;TrustServerCertificate=True;Encrypt=True"
  },
  "SapSettings": {
    "DestinationName": "SAP_ERP",
    "AppServerHost": "sap-app-server.example.local",
    "SystemNumber": "00",
    "SystemId": "PRD",
    "Client": "100",
    "User": "RFC_USER",
    "Password": "",
    "Language": "EN",
    "PoolSize": 5,
    "PeakConnectionsLimit": 10,
    "ConnectionIdleTimeout": 600,
    "ConvertAbapTypes": true
  },
  "SqlSettings": {
    "ConnectionStringName": "SqlServer",
    "BulkCopyBatchSize": 5000,
    "BulkCopyTimeoutSeconds": 600,
    "CommandTimeoutSeconds": 600
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "SyncTables": {
    "Tables": {
      "NPAT": {
        "TargetDbTable": "sap.NPAT",
        "PrimaryKeyColumns": [
          "PATIENTID"
        ],
        "PageSize": 50000,
        "Fields": {
          "PATNR": "PATIENTID",
          "EXTNR": "ID_NUMBER",
          "NNAME": "LAST_NAME_PAT",
          "VNAME": "FRST_NAME_PAT",
          "GSCHL": "SEX",
          "GBDAT": "DOB",
          "GLAND": "BIRTHCTRY",
          "FAMST": "MAR_STAT",
          "KONFE": "REL_DENOM",
          "TODDT": "DT_O_DEATH_FROM",
          "ORT": "CITY",
          "TELF1": "PHONE",
          "ZNKUPA_NOZZ": "HMO"
        }
      },
      "NFAL": {
        "TargetDbTable": "sap.NFAL",
        "PrimaryKeyColumns": [
          "PATCASEID"
        ],
        "PageSize": 50000,
        "Fields": {
          "FALNR": "PATCASEID",
          "PATNR": "PATIENTID",
          "FALAR": "CASETYPE",
          "ERDAT": "CREATION_DATE",
          "STUSR": "CANCEL_USER",
          "STDAT": "CANCEL_DATE"
        }
      },
      "NBEW": {
        "TargetDbTable": "sap.NBEW",
        "PrimaryKeyColumns": [
          "PATCASEID",
          "MOVEMNT_SEQNO"
        ],
        "PageSize": 50000,
        "Fields": {
          "FALNR": "PATCASEID",
          "LFDNR": "MOVEMNT_SEQNO",
          "BWIDT": "MOVEMNT_DATE",
          "BWIZT": "MOVEMNT_TIME",
          "BEWTY": "MOVEMNT_CTGRY",
          "UNFNR": "ACCIDENT_NO",
          "ORGFA": "DEPARTMENT",
          "ORGPF": "NURS_TREAT_OU",
          "STDAT": "CANCEL_DATE",
          "STUSR": "CANCEL_USER"
        }
      },
      "ZNACCIDENT": {
        "TargetDbTable": "sap.ZNACCIDENT",
        "PrimaryKeyColumns": [
          "ACCIDENT_NO"
        ],
        "PageSize": 50000,
        "Fields": {
          "UNFNR": "ACCIDENT_NO",
          "UNFKZ": "ACCIDENT",
          "ZNMCI": "MCI",
          "ZNUNFDT2": "ACCIDENT_DATE",
          "ZUNFZT2": "ACCIDENT_TIME",
          "ZNENDDATE": "END_DATE",
          "ZNENDTIME": "END_TIME"
        }
      },
      "ZNMCICASE": {
        "TargetDbTable": "sap.ZNMCICASE",
        "PrimaryKeyColumns": [
          "ACCIDENT_NO",
          "PATCASEID"
        ],
        "PageSize": 50000,
        "Fields": {
          "UNFNR": "ACCIDENT_NO",
          "FALNR": "PATCASEID",
          "ZNMAININJURY": "MAIN_INJURY",
          "ZNMEDSTATUS": "MEDICAL_STATUS"
        }
      }
    }
  }
}
