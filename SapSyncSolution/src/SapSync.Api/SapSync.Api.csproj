<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- SAP NCo 3.1 native binaries (sapnco_utils.dll) are x64 only. -->
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>sapsync-api-7c3f5d2e-4b1a-4e8f-9a6d-1f2e3d4c5b6a</UserSecretsId>
  </PropertyGroup>

  <Import Project="..\..\build\SapNco.props" />

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SapSync.Core\SapSync.Core.csproj" />
    <ProjectReference Include="..\SapSync.Infrastructure\SapSync.Infrastructure.csproj" />
  </ItemGroup>

</Project>
